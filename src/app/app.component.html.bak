<div class="particle-bg"></div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- SPLASH SCREEN -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div id="splash-screen" class="splash-screen">
  <app-fps-trainer></app-fps-trainer>
  <div class="splash-logo">📔 Diary</div>
  <div class="splash-spinner"></div>
</div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- DESKTOP NAVIGATION (Top) -->
<!-- ═══════════════════════════════════════════════════════════ -->
<nav class="top-nav hide-mobile">
  <div class="nav-container">
    <div class="nav-left">
      <!-- Home -->
      <a routerLink="/" routerLinkActive="active" class="nav-item" title="Home">
        <span class="icon">🏠</span>
      </a>

      <!-- Expenses Dropdown -->
      <div class="nav-item dropdown">
        <span class="icon">💰</span>
        <div class="dropdown-menu">
          <a routerLink="/expenses/create">➕ Add Expense</a>
          <a routerLink="/expenses">📋 Expense List</a>
          <a routerLink="/statement">📊 Statement</a>
        </div>
      </div>

      <!-- Events Dropdown -->
      <div class="nav-item dropdown">
        <span class="icon">📅</span>
        <div class="dropdown-menu">
          <a routerLink="/events/create">➕ Add Event</a>
          <a routerLink="/events">📋 Event List</a>
        </div>
      </div>

      <!-- Analytics Dropdown -->
      <div class="nav-item dropdown">
        <span class="icon">📊</span>
        <div class="dropdown-menu">
          <a routerLink="/calendar">Calendar</a>
          <a routerLink="/dashboard">Dashboard</a>
        </div>
      </div>

      <!-- Notifications -->
      <a routerLink="/notifications" routerLinkActive="active" class="nav-item" title="Notifications">
        <span class="icon">🔔</span>
      </a>

      <!-- Blog -->
      <a routerLink="/blog/create" routerLinkActive="active" class="nav-item" title="Create Blog">
        <span class="icon">✏️</span>
      </a>
    </div>

    <!-- Right Nav Items -->
    <div class="nav-right">
      <!-- Theme Switcher -->
      <div class="theme-switcher">
        <button class="nav-item" (click)="toggleThemeMenu()" title="Change Theme">
          🎨
        </button>
        <div class="theme-menu" *ngIf="showThemeMenu">
          <button *ngFor="let theme of availableThemes" 
            (click)="switchTheme(theme)"
            [class.active]="currentTheme === theme"
            class="theme-option">
            {{ theme | titlecase }}
          </button>
        </div>
      </div>

      <!-- Profile -->
      <a routerLink="/profile" routerLinkActive="active" class="nav-item" title="Profile">
        <span class="icon">👤</span>
      </a>
    </div>
  </div>
</nav>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- MAIN CONTENT -->
<!-- ═══════════════════════════════════════════════════════════ -->
<main class="app-main">
  <router-outlet></router-outlet>
</main>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- MOBILE NAVIGATION (Bottom) -->
<!-- ═══════════════════════════════════════════════════════════ -->
<nav class="bottom-nav hide-desktop">
  <a routerLink="/" routerLinkActive="active" class="nav-item" title="Home">
    <span class="icon">🏠</span>
  </a>

  <a routerLink="/blog/create" routerLinkActive="active" class="nav-item" title="Create Blog">
    <span class="icon">✏️</span>
  </a>

  <a routerLink="/expenses/create" routerLinkActive="active" class="nav-item" title="Add Expense">
    <span class="icon">➕</span>
  </a>

  <a routerLink="/expenses" routerLinkActive="active" class="nav-item" title="Expenses">
    <span class="icon">📋</span>
  </a>

  <a routerLink="/calendar" routerLinkActive="active" class="nav-item" title="Calendar">
    <span class="icon">📅</span>
  </a>

  <a routerLink="/dashboard" routerLinkActive="active" class="nav-item" title="Dashboard">
    <span class="icon">📊</span>
  </a>
</nav>
